{
  "name": "web-three-city",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "prepare": "husky",
    "build:browser": "pnpm --filter @web-three-city/terrain-lab build && pnpm --filter @web-three-city/game build",
    "bootstrap:vercel": "node tooling/bootstrap-vercel-project.mjs",
    "compose:vercel": "node tooling/compose-vercel-output.mjs",
    "typecheck": "pnpm -r --if-present typecheck && pnpm typecheck:browser",
    "typecheck:browser": "tsc -p tsconfig.browser-tests.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,yml,yaml}\"",
    "format:check": "prettier --write packages/traffic-three/src/vehicle-spacing.ts && git diff -- packages/traffic-three/src/vehicle-spacing.ts && false",
    "provenance:check": "node tooling/check-provenance.mjs",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm -r --if-present test:watch",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "test:deployment": "node --test tooling/architecture-boundary.test.mjs tooling/test-topology.test.mjs tooling/ci-topology.test.mjs tooling/development-workflow.test.mjs tooling/compose-vercel-output.test.mjs tooling/bootstrap-vercel-project.test.mjs tooling/verification-scripts.test.mjs tooling/verify-clean-worktree.test.mjs",
    "test:browser": "pnpm build:browser && playwright test",
    "test:browser:only": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm provenance:check && pnpm test:deployment && pnpm test && pnpm build",
    "verify": "pnpm check",
    "verify:full": "pnpm install --frozen-lockfile && pnpm verify && pnpm exec playwright install chromium && pnpm test:browser:only && node tooling/verify-clean-worktree.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "lint-staged": "16.2.4",
    "happy-dom": "20.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "@types/node": "26.1.1",
    "@types/three": "0.185.0",
    "three": "0.185.1"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{mjs,cjs}": "eslint --fix",
    "*.{yml,yaml}": "prettier --write"
  }
}
