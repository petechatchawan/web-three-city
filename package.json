{
  "name": "web-three-city",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{ts,js,yml,yaml}\"",
    "provenance:check": "node tooling/check-provenance.mjs",
    "test": "pnpm -r --if-present test",
    "test:coverage": "node tooling/capture-terraform-diagnostics.mjs",
    "test:browser": "playwright test browser-tests/terraform.spec.ts --reporter=list",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm provenance:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "happy-dom": "20.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
